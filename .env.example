# Copy this file to `.env` and fill it in. `.env` is gitignored and must never
# be committed.

# Nuvio account.
NUVIO_EMAIL=you@example.com
NUVIO_PASSWORD=your-password

# Profile to sync (integer 1-6). `profile_index` from the profile list.
NUVIO_PROFILE=1

# Random string used as part of the addon path. Generate with:
#   openssl rand -hex 32
BRIDGE_TOKEN=replace-with-a-random-token

# Optional overrides. Defaults are the official Nuvio cloud values.
# NUVIO_API_URL=https://api.nuvio.tv
# NUVIO_ANON_KEY=sb_publishable_1Clq8rlTVACkdcZuqr6_AD__xUUC_EN

# Docker network AIOStreams already uses, so the bridge is reachable by
# container name. Find it with:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' <aiostreams_container>
AIO_NETWORK=aiostreams
